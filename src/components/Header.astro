---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/products/jis-heavy-duty/", label: "JIS N150/N200" },
  { href: "/products/din-heavy-duty/", label: "DIN88/DIN100" },
  { href: "/products/bci-request/", label: "BCI Group 31/8D" },
  { href: "/products/24v/", label: "24V Systems" },
  { href: "/products/fleet/", label: "Fleet & OEM" },
  {
    label: "Applications",
    children: [
      { href: "/applications/mining-off-highway/", label: "Mining & Off-Highway" },
      { href: "/applications/cold-chain-refrigerated/", label: "Cold-Chain & Refrigerated" },
      { href: "/applications/bus-coach/", label: "Bus & Coach" },
      { href: "/applications/diesel-generator/", label: "Diesel Generators" },
    ],
  },
  {
    label: "Markets",
    children: [
      { href: "/markets/middle-east/", label: "Middle East" },
      { href: "/markets/africa/", label: "Africa" },
      { href: "/markets/latin-america/", label: "Latin America" },
      { href: "/markets/southeast-asia/", label: "Southeast Asia" },
    ],
  },
  { href: "/selection-tool/", label: "Selection Tool" },
  { href: "https://docs.dinweysbattery.com/", label: "Guides", external: true },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact", cta: true },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="DINWEY Truck Batteries — Home">
      <img src="/images/logo.png" alt="DINWEY" width="40" height="40" />
      <span class="brand-text">DINWEY<small>Truck &amp; Heavy-Duty Battery OEM Factory</small></span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        navItems.map((item) => {
          if (item.children) {
            return (
              <div class="nav-group">
                <button class="nav-group-toggle" aria-haspopup="true" aria-expanded="false">
                  {item.label} ▾
                </button>
                <div class="nav-dropdown" role="menu">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      role="menuitem"
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class={isActive(child.href) ? "active" : ""}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={[
                isActive(item.href) ? "active" : "",
                item.cta ? "nav-cta" : "",
              ].filter(Boolean).join(" ") || undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
