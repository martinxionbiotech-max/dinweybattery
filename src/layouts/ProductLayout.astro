---
import BaseLayout from "./BaseLayout.astro";

interface ProductImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  specTable: { spec: string; value: string }[];
  applications: string[];
  faq: { q: string; a: string }[];
  relatedDocs?: { title: string; url: string }[];
  intro?: string[];
  image?: ProductImage;
  images?: ProductImage[];
}

const {
  title,
  description,
  specTable,
  applications,
  faq,
  relatedDocs = [],
  intro = [],
  image,
  images = []
} = Astro.props;

const galleryImages = images.length > 0 ? images : image ? [image] : [];
const ogImage = galleryImages[0]?.src;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": title,
  "description": description,
  "brand": { "@type": "Brand", "name": "DINWEY" },
  "manufacturer": { "@id": "https://dinweysbattery.com/#organization" }
};
---

<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={[productJsonLd, faqJsonLd]}>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/" style="color:#1e5aa8;">Home</a> &rsaquo; Products &rsaquo; {title}
    </nav>
    <h1 style="color:#0f1f3d;margin-bottom:12px;">{title}</h1>
    <p class="lead">{description}</p>

    {galleryImages.length > 0 && (
      <div class={galleryImages.length > 1 ? "product-gallery" : "product-media"}>
        {galleryImages.map((productImage) => (
          <figure class="product-figure">
            <img
              class="product-image"
              src={productImage.src}
              alt={productImage.alt}
              width={productImage.width}
              height={productImage.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{productImage.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {intro.length > 0 && (
      <div style="margin-top:8px;">
        {intro.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    <h2 style="color:#0f1f3d;margin-top:32px;">Specifications</h2>
    <table>
      <thead>
        <tr><th>Specification</th><th>Value</th></tr>
      </thead>
      <tbody>
        {specTable.map((row) => (
          <tr><td>{row.spec}</td><td>{row.value}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="data-note">
      Specifications are representative ranges for this product family. Exact CCA, capacity
      and dimensions vary by model — contact us for a full datasheet matched to your vehicle.
    </p>

    <h2 style="color:#0f1f3d;">Typical Applications</h2>
    <ul>
      {applications.map((a) => (
        <li>{a}</li>
      ))}
    </ul>

    <h2 style="color:#0f1f3d;margin-top:32px;">Frequently Asked Questions</h2>
    {faq.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}

    <div style="margin-top:32px;">
      <a class="cta" href="/contact/" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">Request Datasheet &amp; Quote</a>
    </div>

    {relatedDocs.length > 0 && (
      <div style="margin-top:32px;padding:20px;background:#f4f7fb;border-radius:8px;">
        <h2 style="color:#0f1f3d;margin-top:0;">Related Technical Documentation</h2>
        <ul style="margin-bottom:0;">
          {relatedDocs.map((d) => (
            <li><a href={d.url} target="_blank" rel="noopener" style="color:#1e5aa8;">{d.title}</a></li>
          ))}
        </ul>
        <p class="data-note" style="margin-top:12px;">From the <a href="https://docs.dinweysbattery.com/" target="_blank" rel="noopener">DINWEY Knowledge Hub</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>
