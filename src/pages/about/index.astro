---
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About DINWEY",
  "url": "https://dinweysbattery.com/about/",
  "mainEntity": { "@id": "https://dinweysbattery.com/#organization" }
};
---

<BaseLayout
  title="About DINWEY — Truck Battery OEM Factory & Manufacturer"
  description="DINWEY is the truck and heavy-duty starting battery brand of Chengguang Energy, a manufacturer founded in 2002 in Hebei, China."
  jsonLd={[aboutJsonLd]}
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">About DINWEY</h1>
    <p class="lead">
      DINWEY is the truck and heavy-duty starting battery brand of Chengguang Energy,
      a manufacturer founded in 2002. We focus on one thing: starting batteries that hold up
      under the demands of commercial trucks — high cold cranking amps, vibration resistance,
      and consistent batch quality.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Our Focus</h2>
    <p>
      While many battery suppliers sell a broad catalog, DINWEY concentrates on the truck and
      heavy-duty vertical. That focus lets us go deep on what matters to commercial-vehicle
      buyers: correct group sizes (JIS N150/N200, DIN88/DIN100; BCI Group 31/8D on request),
      diesel-grade CCA, and 12V vs 24V system requirements.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">The Factory Behind the Brand</h2>
    <p>
      DINWEY is manufactured by Chengguang Energy, a battery manufacturer established in 2002
      in Jinzhou City, Shijiazhuang, Hebei Province, China. The factory spans 200,000 m² with
      18 automated assembly lines producing 40,000 batteries daily, exporting to 70+ countries.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Inside the Factory</h2>
    <p class="lead" style="margin-bottom:16px;">
      A look inside the Chengguang Energy facility in Jinzhou, Hebei — 200,000 m², 18 automated
      assembly lines, and the production floor behind every DINWEY battery.
    </p>
    <section class="factory-gallery" aria-label="Chengguang Energy factory">
      <div class="factory-slot">
        <img src="/images/factory/factory-01.jpg" alt="Chengguang Energy battery factory" width="1508" height="823" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-02.jpg" alt="Chengguang Energy battery factory" width="1517" height="631" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-03.jpg" alt="Chengguang Energy battery factory" width="1514" height="633" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-04.jpg" alt="Chengguang Energy battery factory" width="1512" height="633" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-05.jpg" alt="Chengguang Energy battery factory" width="1530" height="641" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-06.jpg" alt="Chengguang Energy battery factory" width="1526" height="647" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-07.jpg" alt="Chengguang Energy battery factory" width="1528" height="647" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-08.jpg" alt="Chengguang Energy battery factory" width="1533" height="646" loading="lazy" decoding="async" />
      </div>
    </section>

    <h2 style="color:#0f1f3d;margin-top:32px;">Certifications</h2>
    <table>
      <thead>
        <tr><th>Certification</th><th>Scope</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr><td>IATF 16949</td><td>Automotive Quality Management System</td><td>✅ Certified</td></tr>
        <tr><td>ISO 9001:2015</td><td>Quality Management System</td><td>✅ Certified</td></tr>
        <tr><td>ISO 14001:2015</td><td>Environmental Management</td><td>✅ Certified</td></tr>
        <tr><td>ISO 45001:2018</td><td>Occupational Health &amp; Safety</td><td>✅ Certified</td></tr>
        <tr><td>OHSAS 18001</td><td>Health &amp; Safety Management</td><td>✅ Certified</td></tr>
        <tr><td>CE Marking</td><td>European Conformity</td><td>✅ Compliant</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      Certificates available on request. Third-party lab testing (SGS, TÜV, BV) available at
      buyer's request.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">What Our Partners Value</h2>
    <p class="lead" style="margin-bottom:20px;">
      Typical feedback from our partners, anonymized to protect their business identity.
    </p>
    <div class="testimonial">
      <blockquote>
        "Middle East distributors consistently highlight batch-to-batch consistency — every
        delivery ships with CCA test data and full documentation."
      </blockquote>
      <p class="attribution">— Distributor partner (anonymized)</p>
    </div>
    <div class="testimonial">
      <blockquote>
        "South American importers value OEM customization speed — from drawing to approved
        sample, with brand and packaging built to spec."
      </blockquote>
      <p class="attribution">— Importer partner (anonymized)</p>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Contact</h2>
    <p>
      Email: <a href="mailto:martin@dinweys.com">martin@dinweys.com</a><br />
      Phone / WhatsApp: <a href="tel:+8613323237275">+86 13323237275</a><br />
      Address: Lvjiaying Village, Mayu Industrial Park, Jinzhou City, Shijiazhuang, Hebei, China
    </p>
    <p>
      <a href="https://chengguangenergy.com/" target="_blank" rel="noopener" style="color:#1e5aa8;">
        🏭 Visit our factory site: Chengguang Energy
      </a>
    </p>
    <p>
      <a href="https://docs.dinweysbattery.com/" style="color:#1e5aa8;">
        📚 Read the technical guides: DINWEY Knowledge Hub
      </a>
    </p>
  </div>
</BaseLayout>
