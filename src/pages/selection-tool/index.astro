---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Truck Battery Selection Tool"
  description="Find the right DINWEY truck battery: select your vehicle type, electrical system voltage and climate to get a recommended group size and CCA range."
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">Truck Battery Selection Tool</h1>
    <p class="lead">
      Answer three questions to get a recommended battery group size and cold cranking amp
      (CCA) range for your truck. This is a guidance tool — always confirm the final
      specification against your vehicle manual.
    </p>

    <div class="selector">
      <label for="vehicle">1. Vehicle type</label>
      <select id="vehicle">
        <option value="light">Light truck / pickup (12V)</option>
        <option value="medium">Medium-duty truck (12V)</option>
        <option value="heavy">Heavy-duty / semi truck (24V)</option>
        <option value="european">European commercial truck</option>
      </select>

      <label for="climate">2. Climate</label>
      <select id="climate">
        <option value="mild">Mild / temperate</option>
        <option value="cold">Cold winter</option>
        <option value="arctic">Arctic / extreme cold</option>
      </select>

      <button
        id="calc"
        style="margin-top:20px;background:#0f1f3d;color:#fff;border:none;padding:12px 24px;border-radius:6px;font-weight:600;cursor:pointer;"
      >Show Recommendation</button>

      <div class="result" id="result" style="display:none;"></div>
    </div>

    <p class="data-note" style="margin-top:24px;">
      Recommendations are general guidance based on JIS and DIN heavy-duty battery standards
      and typical diesel CCA requirements. Exact CCA, capacity and dimensions vary by vehicle
      — always confirm against your vehicle manual or contact us for a datasheet.
    </p>

    <h2 style="color:#0f1f3d;margin-top:40px;">Full Recommendation Matrix</h2>
    <p>
      The table below lists every recommendation the tool above can produce, so the guidance
      is readable without running any script — and indexable by search engines and AI assistants.
    </p>

    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem;">
        <thead>
          <tr style="background:#0f1f3d;color:#fff;">
            <th style="padding:10px;text-align:left;">Vehicle type</th>
            <th style="padding:10px;text-align:left;">Climate</th>
            <th style="padding:10px;text-align:left;">Recommended battery</th>
            <th style="padding:10px;text-align:left;">CCA</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Light truck / pickup (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Mild / temperate</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 145G51 (N150)</td><td style="padding:10px;border-bottom:1px solid #ddd;">900 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Light truck / pickup (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Cold winter</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 145G51 (N150)</td><td style="padding:10px;border-bottom:1px solid #ddd;">900 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Light truck / pickup (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Arctic / extreme cold</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Medium-duty truck (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Mild / temperate</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Medium-duty truck (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Cold winter</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Medium-duty truck (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Arctic / extreme cold</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Heavy-duty / semi truck (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Mild / temperate</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200)
 — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA each</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Heavy-duty / semi truck (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Cold winter</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200)
 — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA each</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Heavy-duty / semi truck (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Arctic / extreme cold</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200)
 — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA each</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">European commercial truck</td><td style="padding:10px;border-bottom:1px solid #ddd;">Mild / temperate</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 58827 (DIN88)</td><td style="padding:10px;border-bottom:1px solid #ddd;">800 A EN</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">European commercial truck</td><td style="padding:10px;border-bottom:1px solid #ddd;">Cold winter</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 60038 (DIN100)</td><td style="padding:10px;border-bottom:1px solid #ddd;">870 A EN</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">European commercial truck</td><td style="padding:10px;border-bottom:1px solid #ddd;">Arctic / extreme cold</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 60038 (DIN100)</td><td style="padding:10px;border-bottom:1px solid #ddd;">870 A EN</td></tr>
        </tbody>
      </table>
    </div>
    <p style="margin-top:24px;">
      📚 Want the technical detail behind these recommendations? Read the
      <a href="https://docs.dinweysbattery.com/" style="color:#1e5aa8;">DINWEY Knowledge Hub</a> —
      CCA, JIS vs DIN vs BCI standards, and 12V vs 24V system guides.
    </p>
  </div>

  <script>
    const vehicle = document.getElementById("vehicle");
    const climate = document.getElementById("climate");
    const calc = document.getElementById("calc");
    const result = document.getElementById("result");

    const rec = {
      "light-mild": { group: "JIS 145G51 (N150)", cca: "900 CCA" },
      "light-cold": { group: "JIS 145G51 (N150)", cca: "900 CCA" },
      "light-arctic": { group: "JIS 190H52 (N200)", cca: "1100 CCA" },
      "medium-mild": { group: "JIS 190H52 (N200)", cca: "1100 CCA" },
      "medium-cold": { group: "JIS 190H52 (N200)", cca: "1100 CCA" },
      "medium-arctic": { group: "JIS 190H52 (N200)", cca: "1100 CCA" },
      "heavy-mild": { group: "2× JIS 190H52 (N200) — 24V", cca: "1100 CCA each" },
      "heavy-cold": { group: "2× JIS 190H52 (N200) — 24V", cca: "1100 CCA each" },
      "heavy-arctic": { group: "2× JIS 190H52 (N200) — 24V", cca: "1100 CCA each" },
      "european-mild": { group: "DIN 58827 (DIN88)", cca: "800 A EN" },
      "european-cold": { group: "DIN 60038 (DIN100)", cca: "870 A EN" },
      "european-arctic": { group: "DIN 60038 (DIN100)", cca: "870 A EN" },
    };

    calc.addEventListener("click", () => {
      const key = vehicle.value + "-" + climate.value;
      const r = rec[key];
      if (r) {
        result.innerHTML =
          "<strong>Recommended:</strong> " + r.group +
          "<br/>Cold cranking amps: " + r.cca +
          "<br/><br/><em>Confirm final spec against your vehicle manual.</em>";
        result.style.display = "block";
      }
    });
  </script>
</BaseLayout>
