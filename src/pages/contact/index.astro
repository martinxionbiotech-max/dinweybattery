---
import BaseLayout from "../../layouts/BaseLayout.astro";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact DINWEY",
  "url": "https://dinweysbattery.com/contact/",
  "mainEntity": { "@id": "https://dinweysbattery.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you sell truck batteries to end customers or only in bulk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DINWEY primarily supplies distributors, importers, fleet operators and OEM/private-label buyers in bulk. For trade inquiries, email martin@dinweys.com with your vehicle type, group size and target quantity."
      }
    },
    {
      "@type": "Question",
      "name": "What information should I include in my inquiry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Include your vehicle type (light/medium/heavy truck or European commercial vehicle), the battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D), the system voltage (12V or 24V), and your target quantity and destination port."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer OEM and private label truck batteries?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. DINWEY is the truck-battery brand of Chengguang Energy (founded 2002), a manufacturer supporting OEM and private-label programs with custom branding, packaging and specification, exported to 70+ countries."
      }
    }
  ]
};
---

<BaseLayout
  title="Contact DINWEY — Truck Battery Inquiry"
  description="Contact DINWEY for truck battery quotes, datasheets, OEM and private label programs. Email martin@dinweys.com or WhatsApp +86 13323237275."
  jsonLd={[contactJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">Contact &amp; Inquiry</h1>
    <p class="lead">
      For quotes, datasheets, OEM / private label programs or fleet supply, reach us directly.
      We respond to genuine trade inquiries — please include your vehicle type, required group
      size (if known) and target quantity.
    </p>

    <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
      <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp — Contact Now</a>
      <a class="cta" href="mailto:martin@dinweys.com" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">Email Us</a>
    </div>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>Direct Contact</h3>
        <p>
          <strong>Email:</strong> <a href="mailto:martin@dinweys.com">martin@dinweys.com</a><br />
          <strong>Phone / WhatsApp:</strong> <a href="tel:+8613323237275">+86 13323237275</a>
        </p>
      </div>
      <div class="card">
        <h3>Factory</h3>
        <p>
          Chengguang Energy<br />
          Lvjiaying Village, Mayu Industrial Park,<br />
          Jinzhou City, Shijiazhuang, Hebei, China
        </p>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">What to Include in Your Inquiry</h2>
    <ul>
      <li>Vehicle type (light / medium / heavy truck, or European commercial vehicle)</li>
      <li>Required battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D, etc.)</li>
      <li>Electrical system voltage (12V or 24V)</li>
      <li>Target quantity and destination port</li>
    </ul>

    <h2 style="color:#0f1f3d;margin-top:32px;">Who We Work With</h2>
    <p>
      We supply distributors and importers, fleet operators, and OEM / private-label brands
      worldwide. DINWEY is the truck-battery brand of Chengguang Energy, a manufacturer founded
      in 2002 with a 200,000 m² facility, 18 automated lines and daily production of 40,000
      batteries, certified IATF 16949 · ISO 9001 · ISO 14001 · ISO 45001 · OHSAS 18001 · CE,
      exporting to 70+ countries.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>Do you sell truck batteries to end customers or only in bulk?</h3>
      <p>DINWEY primarily supplies distributors, importers, fleet operators and OEM/private-label buyers in bulk. For trade inquiries, email martin@dinweys.com with your vehicle type, group size and target quantity.</p>
    </div>
    <div class="faq-item">
      <h3>What information should I include in my inquiry?</h3>
      <p>Include your vehicle type (light/medium/heavy truck or European commercial vehicle), the battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D), the system voltage (12V or 24V), and your target quantity and destination port.</p>
    </div>
    <div class="faq-item">
      <h3>Do you offer OEM and private label truck batteries?</h3>
      <p>Yes. DINWEY is the truck-battery brand of Chengguang Energy (founded 2002), a manufacturer supporting OEM and private-label programs with custom branding, packaging and specification, exported to 70+ countries.</p>
    </div>

    <p style="margin-top:24px;">
      📚 Not sure which spec you need? Start with the
      <a href="https://docs.dinweysbattery.com/" style="color:#1e5aa8;">DINWEY Knowledge Hub</a> —
      selection guides, CCA and JIS/DIN/BCI standards explained.
    </p>

    <p style="margin-top:16px;">
      Standards referenced:
      <a href="https://batterycouncil.org/" target="_blank" rel="noopener" style="color:#1e5aa8;">Battery Council International (BCI)</a> ·
      <a href="https://www.sae.org/" target="_blank" rel="noopener" style="color:#1e5aa8;">SAE International (J537 CCA)</a>
    </p>
  </div>
</BaseLayout>
