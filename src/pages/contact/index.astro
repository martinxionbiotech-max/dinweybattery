---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact DINWEY — Truck Battery Inquiry"
  description="Contact DINWEY for truck battery quotes, datasheets, OEM and private label programs. Email martin@dinweys.com or WhatsApp +86 13323237275."
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">Contact &amp; Inquiry</h1>
    <p class="lead">
      For quotes, datasheets, OEM / private label programs or fleet supply, reach us directly.
      We respond to genuine trade inquiries — please include your vehicle type, required group
      size (if known) and target quantity.
    </p>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>Direct Contact</h3>
        <p>
          <strong>Email:</strong> <a href="mailto:martin@dinweys.com">martin@dinweys.com</a><br />
          <strong>Phone / WhatsApp:</strong> <a href="tel:+8613323237275">+86 13323237275</a>
        </p>
      </div>
      <div class="card">
        <h3>Factory</h3>
        <p>
          Chengguang Energy<br />
          Lvjiaying Village, Mayu Industrial Park,<br />
          Jinzhou City, Shijiazhuang, Hebei, China
        </p>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">What to Include in Your Inquiry</h2>
    <ul>
      <li>Vehicle type (light / medium / heavy truck, or European commercial vehicle)</li>
      <li>Required battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D, etc.)</li>
      <li>Electrical system voltage (12V or 24V)</li>
      <li>Target quantity and destination port</li>
    </ul>
  </div>
</BaseLayout>
